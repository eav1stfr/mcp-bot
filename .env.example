# Optional are commented out; their defaults work in dev.

# Local: the docker compose Postgres. Production: Neon's *pooled*
# connection string, e.g. postgresql://...-pooler.../db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/couple_bot

# Bearer token for the /api routes. Generate with `openssl rand -hex 32`.
# Left empty, every /api request is refused.
API_TOKEN=change-me

# Set to false in production: hides /docs and /openapi.json
# DEBUG=true

# Runs `alembic upgrade head` on startup. Keep it off on Vercel.
# RUN_MIGRATIONS_UPON_LAUNCH=false

# APP_VERSION
# DEFAULT_PAGE_SIZE
# GLOBAL_API_PREFIX
